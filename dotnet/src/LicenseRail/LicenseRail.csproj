<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LicenseRail</RootNamespace>
    <PackageId>LicenseRail</PackageId>
    <Version>0.1.0</Version>
    <Authors>Codeo Solutions Limited</Authors>
    <Description>LicenseRail client SDK: offline license verification, activation, refresh, floating leases and the management API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
